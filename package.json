{
  "name": "kakaonut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sats hidden in a photo, sent over KakaoTalk. Cashu ecash in the pixels of a PNG.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.13.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "fast-png": "8.0.0",
    "pretendard": "1.3.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
